#!/usr/bin/env bash

# Source shared volume functions
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
. "$SCRIPT_DIR/volume-common.sh"

dir_icons="/usr/local/bin/icons"

# Get volume status using shared function
status=$(get_volume_status)
cur_vol_average=$(echo "$status" | cut -d: -f1)
mute=$(echo "$status" | cut -d: -f2)

if [ "$mute" = "yes" ]; then
    dunstify "Speakers" "Speakers are muted" -r 100 -i "$dir_icons/volume-x.svg"
else
    # Get appropriate icon based on volume level
    icon=$(get_volume_icon "$cur_vol_average" "no")
    dunstify "Speakers" "Speakers are unmuted" -r 100 -i "$dir_icons/$icon.svg"
fi
